{%- liquid
  assign duendes_guide_authorized = false
  assign duendes_guide_required_lineages = ',Mayor,'
  if customer
    for order in customer.orders limit: 100
      for line_item in order.line_items
        assign duendes_lineage = line_item.product.metafields.custom.linaje.value | default: line_item.product.metafields.custom.linaje
        assign duendes_lineage_key = ',' | append: duendes_lineage | append: ','
        if duendes_guide_required_lineages contains duendes_lineage_key
          assign duendes_guide_authorized = true
          break
        endif
      endfor
      if duendes_guide_authorized
        break
      endif
    endfor
  endif
-%}

{%- if duendes_guide_authorized -%}
{% comment %}
  La Guía de los Maestros Gigantes · Duendes del Uruguay · v4.0 BIBLIA
  · Anatomía técnica idéntica a page.libro-elemental.liquid (modelo canónico)
  · PageFlip v2.0.7 · buscador integrado funcional · audio Web API procedural
  · lang-overlay ES/EN · auto-numbering · responsive mobile <768px
  · SVG ornaments: #r-triskele, #r-triqueta, #r-awen, #r-knot, #r-star4, #r-moon
  · Fonts: Cinzel + Great Vibes + Cormorant Garamond
  · ~46 páginas · paleta BORDÓ profundo + ORO viejo · linaje MAESTROS GIGANTES
  · Únicos, irrepetibles, ancestrales · don principal: PERSPECTIVA
  · Voz Río de la Plata · grave, sabia, íntima
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Saira+Condensed:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  .libro-wrap {
    /* PALETA GIGANTES · bordó profundo + oro viejo */
    --black-deep: #0a0404; --cream: #F4ECDE; --cream-light: #FAF3E6;
    --gold: #C9A961; --gold-bright: #D8B872; --gold-dark: #8b7137; --gold-old: #6f5827;
    --bordeaux-deep: #4a1414; --bordeaux: #6e1d1d; --bordeaux-medium: #8a3030; --bordeaux-light: #b25555;
    --bordeaux-blush: #efd6d6;
    --red-deep: #5a1515;
    --brown-deep: #2a1010; --brown-soft: #523030;
    --line-gold: rgba(201,169,97,0.32);
    --line-bordeaux: rgba(138,48,48,0.32);
    --wood-base: #2a0e0e; --wood-mid: #38161a; --wood-light: #481c20; --wood-dark: #160606;
    --font-info: 'Agency FB', 'Saira Condensed', 'Trebuchet MS', sans-serif;

    color: var(--cream); font-family: 'Cormorant Garamond', Georgia, serif;
    min-height: 100vh; padding: 28px 16px 60px; text-align: center;
    background-color: #100404;
    background-image:
      radial-gradient(ellipse at 50% 30%, rgba(110,29,29,0.45) 0%, rgba(8,3,3,0.95) 70%),
      radial-gradient(circle at 12% 88%, rgba(201,169,97,0.13) 0%, transparent 40%),
      radial-gradient(circle at 88% 12%, rgba(178,85,85,0.12) 0%, transparent 40%),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='600' height='600' viewBox='0 0 600 600'><g fill='none' stroke='%23C9A961' stroke-width='1.5' opacity='0.06'><text x='300' y='180' text-anchor='middle' font-family='serif' font-style='italic' font-size='40' fill='%23C9A961' opacity='0.9'>Maestros Gigantes</text><text x='300' y='220' text-anchor='middle' font-family='serif' font-size='12' letter-spacing='8' fill='%23C9A961' opacity='0.85'>%E2%9C%A6  %C3%9A N I C O S  %E2%9C%A6</text><text x='300' y='460' text-anchor='middle' font-family='serif' font-style='italic' font-size='40' fill='%23C9A961' opacity='0.9'>Maestros Gigantes</text><text x='300' y='500' text-anchor='middle' font-family='serif' font-size='12' letter-spacing='8' fill='%23C9A961' opacity='0.85'>%E2%9C%A6  I R R E P E T I B L E S  %E2%9C%A6</text></g></svg>"),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='400' viewBox='0 0 400 400'><defs><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3'/><feColorMatrix values='0 0 0 0 0.55 0 0 0 0 0.18 0 0 0 0 0.18 0 0 0 0.05 0'/></filter></defs><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    background-size: cover, cover, cover, 600px 600px, 400px 400px;
    background-repeat: no-repeat, no-repeat, no-repeat, repeat, repeat;
    background-attachment: fixed; position: relative; min-height: 100vh; overflow-x: hidden;
  }

  /* GLOW bordó + oro sutil en esquinas */
  .libro-wrap::before {
    content:''; position: fixed; top: -100px; right: -100px; width: 500px; height: 500px; pointer-events: none; z-index: 0;
    background: radial-gradient(circle at center, rgba(178,85,85,0.20) 0%, rgba(178,85,85,0.05) 40%, transparent 70%);
    animation: glowPulse 10s ease-in-out infinite;
  }
  @keyframes glowPulse {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
  }
  .libro-wrap::after {
    content:''; position: fixed; bottom: -80px; left: -80px; width: 400px; height: 400px; pointer-events: none; z-index: 0;
    background: radial-gradient(circle at center, rgba(201,169,97,0.14) 0%, rgba(201,169,97,0.04) 50%, transparent 75%);
    animation: glowPulse 12s ease-in-out infinite reverse;
  }

  .libro-wrap > * { position: relative; z-index: 1; }
  .libro-wrap * { box-sizing: border-box; }

  .libro-header { max-width: 760px; margin: 0 auto 24px; text-align: center; }
  .libro-header .eyebrow { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.5em; color: var(--gold); text-transform: uppercase; margin-bottom: 12px; text-shadow: 0 2px 8px rgba(0,0,0,0.7); }
  .libro-header h1 { font-family: 'Great Vibes', cursive; font-size: clamp(44px, 6.5vw, 72px); margin: 0 0 8px; line-height: 1; font-weight: 400; color: var(--cream); text-shadow: 0 4px 18px rgba(0,0,0,0.85); }
  .libro-header .sub { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.5em; color: var(--gold-bright); text-transform: uppercase; text-shadow: 0 2px 8px rgba(0,0,0,0.7); }

  .lang-overlay { position: fixed; inset: 0; background: rgba(10,4,4,0.97); z-index: 9999; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8px); }
  .lang-overlay.hide { display: none; }
  .lang-box { max-width: 480px; text-align: center; padding: 40px 32px; border: 1px solid var(--gold); background: linear-gradient(160deg, #1c0a0a 0%, #0a0404 100%); position: relative; }
  .lang-box::before { content:''; position: absolute; inset: 8px; border: 1px solid rgba(201,169,97,0.3); pointer-events:none; }
  .lang-box .ornament { color: var(--gold); font-family: 'Cinzel', serif; font-size: 14px; letter-spacing: 0.7em; margin-bottom: 18px; }
  .lang-box h2 { font-family: 'Great Vibes', cursive; font-weight: 400; font-size: 56px; color: var(--cream); margin: 0 0 8px; line-height: 1; }
  .lang-box .pretitle { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.4em; color: var(--gold); text-transform: uppercase; margin-bottom: 18px; }
  .lang-box p { font-family: var(--font-info); font-size: 16px; color: rgba(244,236,222,0.85); margin: 14px 0 28px; }
  .lang-buttons { display: flex; gap: 14px; justify-content: center; }
  .lang-buttons button { background: transparent; color: var(--cream); border: 1px solid var(--gold); padding: 14px 32px; font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.4em; text-transform: uppercase; cursor: pointer; transition: all 0.3s; }
  .lang-buttons button:hover { background: var(--gold); color: var(--black-deep); }
  .lang-buttons .recommended { background: var(--gold); color: var(--black-deep); }

  .flipbook-container { display: flex; justify-content: center; align-items: center; margin: 0 auto; max-width: 1120px; min-height: 600px; padding: 16px; }
  #book {
    box-shadow: 0 32px 100px rgba(0,0,0,0.9), 0 0 0 8px rgba(40,10,10,0.85), 0 0 0 9px var(--gold-old);
    border-radius: 4px;
    touch-action: pan-y;
  }
  /* PÁGINAS · paleta AMBAR/cream básica + variantes bordó */
  .page { background: var(--cream); color: var(--brown-deep); overflow: hidden; }
  .page-inner { padding: 32px 30px 28px; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; text-align: center; gap: 6px; }

  /* DARK · negro profundo con acentos oro */
  .page.dark { background: var(--black-deep); color: var(--cream); }
  .page.dark .page-inner::before { content: ''; position: absolute; inset: 14px; border: 1px solid rgba(201,169,97,0.22); pointer-events: none; }

  /* AMBER · ámbar cálido luminoso (papel oro viejo) */
  .page.amber {
    background:
      radial-gradient(ellipse at 30% 20%, rgba(216,184,114,0.22) 0%, transparent 60%),
      linear-gradient(160deg, #f6e6c5 0%, #ebd5a7 100%);
    color: var(--brown-deep);
  }
  .page.amber .page-inner::before { content: ''; position: absolute; inset: 14px; border: 1px solid rgba(139,113,55,0.32); pointer-events: none; }

  /* DEEP-AMBER · ámbar profundo (cuero envejecido) */
  .page.deep-amber {
    background:
      radial-gradient(ellipse at 50% 30%, rgba(139,113,55,0.28) 0%, transparent 60%),
      linear-gradient(160deg, #7a5a26 0%, #4f3818 100%);
    color: var(--cream);
  }
  .page.deep-amber .page-inner::before { content: ''; position: absolute; inset: 14px; border: 1px solid rgba(201,169,97,0.35); pointer-events: none; }
  .page.deep-amber h2, .page.deep-amber h3 { color: var(--cream); }
  .page.deep-amber p { color: var(--cream); }
  .page.deep-amber strong { color: var(--gold-bright); }

  /* BORDO · bordó profundo (sello / linaje) */
  .page.bordo {
    background:
      radial-gradient(ellipse at 50% 30%, rgba(138,48,48,0.30) 0%, transparent 60%),
      linear-gradient(160deg, var(--bordeaux) 0%, var(--bordeaux-deep) 100%);
    color: var(--cream);
  }
  .page.bordo .page-inner::before { content: ''; position: absolute; inset: 14px; border: 1px solid rgba(201,169,97,0.32); pointer-events: none; }
  .page.bordo h2, .page.bordo h3 { color: var(--cream); }
  .page.bordo p { color: var(--cream); }
  .page.bordo strong { color: var(--gold-bright); }
  .page.bordo .eyebrow { color: var(--gold-bright); }

  .page .eyebrow { font-family: 'Cinzel', serif; font-weight: 400; font-size: 9.5px; letter-spacing: 0.5em; color: var(--gold-old); text-transform: uppercase; margin-bottom: 14px; text-align: center; width: 100%; }
  .page.dark .eyebrow, .page.bordo .eyebrow, .page.deep-amber .eyebrow { color: var(--gold); }
  .page h2 { font-family: 'Great Vibes', cursive; font-size: 48px; margin: 0 auto 14px; line-height: 1; font-weight: 400; color: var(--brown-deep); text-align: center; width: 100%; }
  .page.dark h2 { color: var(--cream); }
  .page h3 { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10.5px; letter-spacing: 0.3em; color: var(--gold-old); text-transform: uppercase; margin: 12px 0 8px; text-align: center; width: 100%; }
  .page.dark h3 { color: var(--gold); }

  /* TEXTO DE INFO */
  .page p { font-family: var(--font-info); font-weight: 400; font-size: 14px; line-height: 1.55; margin: 0 auto 10px; color: var(--brown-deep); text-align: center; max-width: 380px; letter-spacing: 0.01em; }
  .page.dark p { color: var(--cream); }
  .page p.lead { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; color: var(--brown-soft); font-size: 14.5px; }
  .page.dark p.lead, .page.bordo p.lead, .page.deep-amber p.lead { color: rgba(244,236,222,0.85); }
  .page strong { color: var(--brown-deep); font-weight: 600; }
  .page.dark strong { color: var(--cream); }
  .page em { font-style: italic; }

  .page .center-content { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; width: 100%; text-align: center; }
  .page .symbol-row { color: var(--gold); letter-spacing: 0.7em; font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; text-align: center; }

  .page .page-number { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); font-family: 'Cinzel', serif; font-weight: 400; font-size: 9px; letter-spacing: 0.35em; color: var(--gold-old); }
  .page.dark .page-number, .page.bordo .page-number, .page.deep-amber .page-number { color: var(--gold); opacity: 0.65; }

  /* TAPA · bordó profundo con acentos oro */
  .page.cover {
    background:
      radial-gradient(ellipse at 30% 30%, rgba(110,29,29,0.55), transparent 60%),
      radial-gradient(ellipse at 70% 70%, rgba(60,15,15,0.65), transparent 60%),
      linear-gradient(135deg, #2a0a0a 0%, #0a0404 50%, #38161a 100%);
    color: var(--cream); position: relative; box-shadow: inset 0 0 80px rgba(0,0,0,0.85);
  }
  .page.cover::before { content:''; position: absolute; inset: 22px; border: 1px solid rgba(201,169,97,0.55); }
  .page.cover::after { content:''; position: absolute; inset: 32px; border: 1px solid rgba(201,169,97,0.20); }
  .page.cover .page-inner { z-index: 2; align-items: center; justify-content: space-between; padding: 60px 30px; gap: 12px; text-align: center; }
  .page.cover .ornament-celtic-top { width: 80px; height: 80px; flex-shrink: 0; color: var(--gold); opacity: 0.95; }
  .page.cover .titulo-grande { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.5em; color: var(--gold); text-transform: uppercase; line-height: 1.4; text-align: center; }
  .page.cover h1 { font-family: 'Great Vibes', cursive; font-weight: 400; font-size: 58px; margin: 6px 0 8px; line-height: 1; color: var(--cream); text-shadow: 0 0 28px rgba(201,169,97,0.40); text-align: center; }
  .page.cover .marca-fina { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.6em; color: var(--gold-bright); text-transform: uppercase; text-align: center; }
  .page.cover .pie { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 11px; color: rgba(244,236,222,0.65); margin: 0; text-align: center; }

  svg.ornament { display: block; margin: 14px auto; color: var(--gold-old); }
  svg.ornament.dark { color: var(--gold); }
  svg.ornament.tiny { width: 32px; height: 32px; }
  svg.ornament.small { width: 60px; height: 60px; }
  svg.ornament.med { width: 90px; height: 90px; }

  .indice { font-family: var(--font-info); font-size: 12px; letter-spacing: 0.05em; color: var(--brown-deep); text-align: left; max-width: 380px; margin: 0 auto; }
  .indice-item { display: flex; justify-content: space-between; align-items: baseline; margin: 6px 0; }
  .indice-item .num { color: var(--gold-old); margin-right: 8px; font-size: 11px; font-family: 'Cinzel', serif; letter-spacing: 0.15em; }
  .indice-item .name { flex: 1; }
  .indice-item .dots { flex: 1; border-bottom: 1px dotted var(--gold-old); margin: 0 8px; align-self: end; height: 1px; }
  .indice-item .pg { color: var(--gold-old); font-family: 'Cinzel', serif; }
  .indice-section { font-family: 'Cinzel', serif; font-weight: 500; font-size: 10px; letter-spacing: 0.35em; color: var(--bordeaux); text-transform: uppercase; margin: 12px 0 4px; padding-bottom: 4px; border-bottom: 1px solid var(--gold-old); text-align: center; }

  .page .cita { font-family: 'Great Vibes', cursive; font-size: 40px; line-height: 1.2; color: var(--bordeaux); text-align: center; padding: 16px 14px; font-weight: 400; }
  .page.dark .cita, .page.bordo .cita, .page.deep-amber .cita { color: var(--cream); font-size: 48px; }

  .foto-circle { width: 130px; height: 130px; border-radius: 50%; margin: 14px auto; overflow: hidden; border: 2px solid var(--gold); box-shadow: 0 8px 26px rgba(0,0,0,0.4); display: block; }
  .foto-circle img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .foto-rounded { width: 200px; height: 130px; border-radius: 16px; margin: 14px auto; overflow: hidden; border: 1px solid var(--gold); box-shadow: 0 6px 22px rgba(0,0,0,0.35); display: block; }
  .foto-rounded img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .foto-arch { width: 130px; height: 170px; border-radius: 65px 65px 6px 6px; margin: 14px auto; overflow: hidden; border: 1px solid var(--gold); box-shadow: 0 8px 26px rgba(0,0,0,0.4); display: block; }
  .foto-arch img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .foto-caption { font-family: 'Cinzel', serif; font-weight: 400; font-size: 9px; letter-spacing: 0.35em; color: var(--gold-old); text-transform: uppercase; margin-top: 8px; text-align: center; }

  .consejo-card { background: var(--cream-light); border: 1px solid var(--gold-old); border-radius: 6px; padding: 12px 14px; margin: 8px auto; text-align: center; max-width: 360px; }
  .consejo-card .titulo { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.3em; color: var(--bordeaux); text-transform: uppercase; margin-bottom: 5px; text-align: center; }
  .consejo-card p { font-family: var(--font-info); font-size: 13.5px; margin: 0 auto; line-height: 1.5; max-width: none; text-align: center; color: var(--brown-deep); }
  .consejo-card.warning { border-color: var(--bordeaux-medium); background: #f5e0e0; }
  .consejo-card.warning .titulo { color: var(--bordeaux-deep); }
  .consejo-card.elemento { background: linear-gradient(180deg, var(--cream-light) 0%, #efd8b0 100%); border-width: 1.5px; }

  .elementos-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--gold-old); margin: 10px auto; max-width: 380px; }
  .elemento-cell { padding: 12px 10px; border-right: 1px solid var(--gold-old); border-bottom: 1px solid var(--gold-old); text-align: center; }
  .elemento-cell:nth-child(2n) { border-right: none; }
  .elemento-cell:nth-last-child(-n+2) { border-bottom: none; }
  .elemento-cell .titulo { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.3em; color: var(--bordeaux); margin-bottom: 5px; text-align: center; }
  .elemento-cell .quien { font-family: var(--font-info); font-size: 12px; color: var(--brown-deep); margin-bottom: 4px; font-weight: 500; text-align: center; }
  .elemento-cell .funcion { font-family: var(--font-info); font-size: 11.5px; color: var(--brown-soft); line-height: 1.45; text-align: center; }

  .dia-item { padding: 6px 8px; border-bottom: 1px solid var(--line-gold); text-align: center; max-width: 360px; margin: 0 auto; }
  .dia-item:last-child { border-bottom: none; }
  .dia-item .num { font-family: 'Cinzel', serif; font-weight: 400; font-size: 9.5px; letter-spacing: 0.3em; color: var(--bordeaux); }
  .dia-item .titulo { font-family: 'Cinzel', serif; font-weight: 400; font-size: 9.5px; letter-spacing: 0.2em; color: var(--brown-deep); }
  .dia-item .desc { font-family: var(--font-info); font-size: 12.5px; color: var(--brown-soft); line-height: 1.5; margin-top: 2px; text-align: center; }

  .compendio-tabla { font-size: 11px; max-width: 380px; margin: 0 auto; }
  .compendio-row { display: flex; padding: 7px 0; border-bottom: 1px solid var(--line-gold); align-items: baseline; text-align: left; }
  .compendio-row:last-child { border-bottom: none; }
  .compendio-row .nombre { flex: 0 0 110px; color: var(--bordeaux); letter-spacing: 0.18em; text-transform: uppercase; font-family: 'Cinzel', serif; font-weight: 400; font-size: 9.5px; }
  .compendio-row .uso { flex: 1; color: var(--brown-soft); font-family: var(--font-info); font-size: 12.5px; }

  .faq { margin: 8px auto; padding-bottom: 8px; border-bottom: 1px dotted var(--line-gold); text-align: center; max-width: 380px; }
  .faq:last-child { border-bottom: none; }
  .faq .pregunta { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.2em; color: var(--bordeaux); text-transform: uppercase; margin-bottom: 5px; text-align: center; }
  .faq .respuesta { font-family: var(--font-info); font-size: 12.5px; color: var(--brown-soft); line-height: 1.55; margin: 0 auto; text-align: center; }

  /* MAESTRO · card destacada con bordó */
  .ser-card { background: linear-gradient(160deg, var(--cream-light) 0%, #e8d4b0 100%); border: 1.5px solid var(--bordeaux); border-radius: 8px; padding: 14px 16px; margin: 8px auto; max-width: 380px; box-shadow: 0 4px 14px rgba(74,20,20,0.18); }
  .ser-card .ser-nombre { font-family: 'Great Vibes', cursive; font-size: 32px; color: var(--bordeaux-deep); margin: 0 0 4px; line-height: 1; }
  .ser-card .ser-energia { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 0.4em; color: var(--gold-old); text-transform: uppercase; margin-bottom: 8px; }
  .ser-card .ser-detalle { font-family: var(--font-info); font-size: 12.5px; color: var(--brown-soft); line-height: 1.5; margin: 0 auto 8px; text-align: center; }
  .ser-card .ser-meta { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 8px; }
  .ser-card .ser-meta span { font-family: 'Cinzel', serif; font-size: 8.5px; letter-spacing: 0.2em; color: var(--bordeaux); text-transform: uppercase; padding: 3px 8px; border: 1px solid var(--bordeaux); border-radius: 100px; }

