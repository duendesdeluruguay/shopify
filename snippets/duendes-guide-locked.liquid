{% doc %}
Renders the locked state for a guide page when the current customer is not entitled to it.

@param {string} guide_title - The guide title to display.
@param {string} required_label - Human-readable entitlement requirement.

@example
{% render 'duendes-guide-locked', guide_title: 'La Guía de las Hadas', required_label: 'un guardián del linaje Hada' %}
{% enddoc %}
<style>
  .du-guide-lock {
    min-height: 72vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 18px;
    background:
      radial-gradient(circle at 50% 16%, rgba(201, 169, 97, 0.22), transparent 38%),
      linear-gradient(180deg, #120d08 0%, #050403 100%);
    color: #f7eedb;
    text-align: center;
  }

  .du-guide-lock__card {
    width: min(680px, 100%);
    padding: clamp(28px, 6vw, 56px);
    border: 1px solid rgba(201, 169, 97, 0.42);
    border-radius: 28px;
    background: rgba(12, 8, 5, 0.82);
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.45);
  }

  .du-guide-lock__eyebrow {
    margin: 0 0 14px;
    color: #d8b872;
    font: 600 12px/1.4 Cinzel, Georgia, serif;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .du-guide-lock h1 {
    margin: 0 0 18px;
    color: #fff8e8;
    font-family: Cinzel, Georgia, serif;
    font-size: clamp(30px, 6vw, 54px);
    line-height: 1.08;
  }

  .du-guide-lock p {
    max-width: 560px;
    margin: 0 auto 26px;
    color: rgba(247, 238, 219, 0.82);
    font-size: 17px;
    line-height: 1.6;
  }

  .du-guide-lock__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .du-guide-lock__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 22px;
    border: 1px solid rgba(216, 184, 114, 0.78);
    border-radius: 999px;
    color: #120d08;
    background: #d8b872;
    font-weight: 700;
    text-decoration: none;
  }

  .du-guide-lock__button--secondary {
    color: #f7eedb;
    background: transparent;
  }
</style>

<section class="du-guide-lock" aria-labelledby="du-guide-lock-title">
  <div class="du-guide-lock__card">
    <p class="du-guide-lock__eyebrow">Biblioteca de los Elegidos</p>
    <h1 id="du-guide-lock-title">{{ guide_title | escape }}</h1>
    {% if customer %}
      <p>Este libro está sellado para tu cuenta. Se desbloquea cuando tenés {{ required_label | escape }} en una compra activa.</p>
      <div class="du-guide-lock__actions">
        <a class="du-guide-lock__button" href="/pages/el-portal">Volver a Mi Magia</a>
        <a class="du-guide-lock__button du-guide-lock__button--secondary" href="/collections/all">Ver guardianes</a>
      </div>
    {% else %}
      <p>Iniciá sesión para abrir tu biblioteca. Si ya adoptaste {{ required_label | escape }}, el libro se desbloquea al entrar con tu cuenta.</p>
      <div class="du-guide-lock__actions">
        <a class="du-guide-lock__button" href="{{ routes.account_login_url }}">Iniciar sesión</a>
        <a class="du-guide-lock__button du-guide-lock__button--secondary" href="/pages/el-portal">Ir a Mi Magia</a>
      </div>
    {% endif %}
  </div>
</section>
