<style>
  .du-flipbook-locked {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding: 64px 18px;
    color: #f8efe1;
    text-align: center;
    background:
      radial-gradient(circle at 50% 20%, rgba(201, 169, 97, 0.24), transparent 42%),
      linear-gradient(160deg, #120b08 0%, #050403 100%);
  }

  .du-flipbook-locked__box {
    width: min(640px, 100%);
    padding: clamp(28px, 5vw, 52px);
    border: 1px solid rgba(201, 169, 97, 0.48);
    background: rgba(12, 8, 6, 0.78);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
  }

  .du-flipbook-locked__eyebrow {
    margin: 0 0 14px;
    color: #d8b872;
    font: 600 12px/1.4 Cinzel, Georgia, serif;
    letter-spacing: 0.36em;
    text-transform: uppercase;
  }

  .du-flipbook-locked__title {
    margin: 0;
    color: #fff8e8;
    font: 400 clamp(34px, 7vw, 58px)/1.05 "Cormorant Garamond", Georgia, serif;
  }

  .du-flipbook-locked__text {
    max-width: 46ch;
    margin: 18px auto 0;
    color: rgba(248, 239, 225, 0.82);
    font: 400 18px/1.55 "Cormorant Garamond", Georgia, serif;
  }

  .du-flipbook-locked__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }

  .du-flipbook-locked__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 22px;
    border: 1px solid #c9a961;
    color: #0a0806;
    background: #c9a961;
    font: 600 12px/1.2 Cinzel, Georgia, serif;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .du-flipbook-locked__button--secondary {
    color: #f8efe1;
    background: transparent;
  }
</style>

<section class="du-flipbook-locked" aria-label="Libro sellado">
  <div class="du-flipbook-locked__box">
    <p class="du-flipbook-locked__eyebrow">Libro sellado</p>
    <h1 class="du-flipbook-locked__title">{{ book_title | escape }}</h1>
    <p class="du-flipbook-locked__text">
      Este libro se abre solo para clientes logueados que ya adoptaron {{ required_label | escape }}.
      Iniciá sesión con el email de tu compra o entrá al Portal para ver tu biblioteca.
    </p>
    <div class="du-flipbook-locked__actions">
      <a class="du-flipbook-locked__button" href="{{ routes.account_login_url }}">Iniciar sesión</a>
      <a class="du-flipbook-locked__button du-flipbook-locked__button--secondary" href="/pages/el-portal">Ir al Portal</a>
      {%- if collection_url != blank -%}
        <a class="du-flipbook-locked__button du-flipbook-locked__button--secondary" href="{{ collection_url }}">Adoptar {{ required_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
