{%- liquid
  assign duendes_guide_has_access = false
  if customer
    for duendes_order in customer.orders limit: 100
      unless duendes_order.cancelled
        if duendes_order.financial_status == 'paid'
          for duendes_line_item in duendes_order.line_items
            assign duendes_lineage = duendes_line_item.product.metafields.custom.linaje.value | default: duendes_line_item.product.metafields.custom.linaje
            if duendes_lineage == 'Elfo'
              assign duendes_guide_has_access = true
              break
            endif
          endfor
        endif
      endunless
      if duendes_guide_has_access
        break
      endif
    endfor
  endif
-%}

{%- if duendes_guide_has_access -%}

{% comment %}
  La Guía de los Elfos · Duendes del Uruguay · v4.0 BIBLIA
  · Tipografía: Cinzel (títulos) + Great Vibes (display) + Cormorant Garamond (body)
  · Todo el texto centrado
  · ~46 páginas · linaje ELFOS · paleta azul profundo + plata
  · Abrecaminos · nobles · masculinos · linaje vegetal
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Saira+Condensed:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  .libro-wrap {
    --black-deep: #050812; --cream: #EDEEF6; --cream-light: #F4F5FB;
    --silver: #B8C3DC; --silver-bright: #D4DCEC; --silver-dark: #6E7DA0;
    --indigo-deep: #0E1330; --indigo-soft: #1B2350; --indigo-light: #2C3870;
    --line-silver: rgba(184,195,220,0.25);
    --font-info: 'Agency FB', 'Saira Condensed', 'Trebuchet MS', sans-serif;

    color: var(--cream); font-family: 'Cormorant Garamond', Georgia, serif;
    min-height: 100vh; padding: 28px 16px 60px; text-align: center;
    background-color: #050812;
    background-image:
      radial-gradient(ellipse at 50% 30%, rgba(30,45,90,0.45) 0%, rgba(5,8,18,0.94) 70%),
      radial-gradient(circle at 12% 88%, rgba(184,195,220,0.12) 0%, transparent 40%),
      radial-gradient(circle at 88% 12%, rgba(184,195,220,0.10) 0%, transparent 40%),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='600' height='600' viewBox='0 0 600 600'><g fill='none' stroke='%23B8C3DC' stroke-width='1.5' opacity='0.06'><text x='300' y='180' text-anchor='middle' font-family='serif' font-style='italic' font-size='44' fill='%23B8C3DC' opacity='0.9'>Linaje Elfos</text><text x='300' y='220' text-anchor='middle' font-family='serif' font-size='14' letter-spacing='8' fill='%23B8C3DC' opacity='0.85'>%E2%9C%A6  %E2%9C%A6  %E2%9C%A6</text><text x='300' y='460' text-anchor='middle' font-family='serif' font-style='italic' font-size='44' fill='%23B8C3DC' opacity='0.9'>Linaje Elfos</text><text x='300' y='500' text-anchor='middle' font-family='serif' font-size='14' letter-spacing='8' fill='%23B8C3DC' opacity='0.85'>%E2%9C%A6  %E2%9C%A6  %E2%9C%A6</text></g></svg>"),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='400' viewBox='0 0 400 400'><defs><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3'/><feColorMatrix values='0 0 0 0 0.72 0 0 0 0 0.76 0 0 0 0 0.86 0 0 0 0.04 0'/></filter></defs><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    background-size: cover, cover, cover, 600px 600px, 400px 400px;
    background-repeat: no-repeat, no-repeat, no-repeat, repeat, repeat;
    background-attachment: fixed; position: relative; min-height: 100vh; overflow-x: hidden;
  }

  /* GLOW plateado sutil en esquinas */
  .libro-wrap::before {
    content:''; position: fixed; top: -100px; right: -100px; width: 500px; height: 500px; pointer-events: none; z-index: 0;
    background: radial-gradient(circle at center, rgba(184,195,220,0.18) 0%, rgba(184,195,220,0.05) 40%, transparent 70%);
    animation: glowPulse 9s ease-in-out infinite;
  }
  @keyframes glowPulse {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
  }
  .libro-wrap::after {
    content:''; position: fixed; bottom: -80px; left: -80px; width: 400px; height: 400px; pointer-events: none; z-index: 0;
    background: radial-gradient(circle at center, rgba(184,195,220,0.12) 0%, rgba(184,195,220,0.04) 50%, transparent 75%);
    animation: glowPulse 11s ease-in-out infinite reverse;
  }

  .libro-wrap > * { position: relative; z-index: 1; }
  .libro-wrap * { box-sizing: border-box; }

  .libro-header { max-width: 760px; margin: 0 auto 24px; text-align: center; }
  .libro-header .eyebrow { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.5em; color: var(--silver); text-transform: uppercase; margin-bottom: 12px; text-shadow: 0 2px 8px rgba(0,0,0,0.7); }
  .libro-header h1 { font-family: 'Great Vibes', cursive; font-size: clamp(44px, 6.5vw, 72px); margin: 0 0 8px; line-height: 1; font-weight: 400; color: var(--cream); text-shadow: 0 4px 18px rgba(0,0,0,0.8); }
  .libro-header .sub { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.5em; color: var(--silver-bright); text-transform: uppercase; text-shadow: 0 2px 8px rgba(0,0,0,0.7); }

  .lang-overlay { position: fixed; inset: 0; background: rgba(5,8,18,0.97); z-index: 9999; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8px); }
  .lang-overlay.hide { display: none; }
  .lang-box { max-width: 480px; text-align: center; padding: 40px 32px; border: 1px solid var(--silver); background: linear-gradient(160deg, #0E1330 0%, #050812 100%); position: relative; }
  .lang-box::before { content:''; position: absolute; inset: 8px; border: 1px solid rgba(184,195,220,0.3); pointer-events:none; }
  .lang-box .ornament { color: var(--silver); font-family: 'Cinzel', serif; font-size: 14px; letter-spacing: 0.7em; margin-bottom: 18px; }
  .lang-box h2 { font-family: 'Great Vibes', cursive; font-weight: 400; font-size: 56px; color: var(--cream); margin: 0 0 8px; line-height: 1; }
  .lang-box .pretitle { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.4em; color: var(--silver); text-transform: uppercase; margin-bottom: 18px; }
  .lang-box p { font-family: var(--font-info); font-size: 16px; color: rgba(237,238,246,0.85); margin: 14px 0 28px; }
  .lang-buttons { display: flex; gap: 14px; justify-content: center; }
  .lang-buttons button { background: transparent; color: var(--cream); border: 1px solid var(--silver); padding: 14px 32px; font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.4em; text-transform: uppercase; cursor: pointer; transition: all 0.3s; }
  .lang-buttons button:hover { background: var(--silver); color: var(--black-deep); }
  .lang-buttons .recommended { background: var(--silver); color: var(--black-deep); }

  .flipbook-container { display: flex; justify-content: center; align-items: center; margin: 0 auto; max-width: 1120px; min-height: 600px; padding: 16px; }
  #book {
    box-shadow: 0 32px 100px rgba(0,0,0,0.85), 0 0 0 8px rgba(14,19,48,0.7), 0 0 0 9px var(--silver-dark);
    border-radius: 4px;
    touch-action: pan-y;
  }
  .page { background: var(--cream-light); color: var(--indigo-deep); overflow: hidden; }
  .page-inner { padding: 32px 30px 28px; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; text-align: center; gap: 6px; }
  .page.dark { background: var(--indigo-deep); color: var(--cream); }
  .page.deep-indigo { background: linear-gradient(160deg, var(--indigo-deep) 0%, var(--indigo-soft) 100%); color: var(--cream); }
  .page.indigo { background: linear-gradient(160deg, #DDE3F4 0%, #C7D0E7 100%); color: var(--indigo-deep); }
  .page.dark .page-inner::before,
  .page.deep-indigo .page-inner::before { content: ''; position: absolute; inset: 14px; border: 1px solid rgba(184,195,220,0.22); pointer-events: none; }

  .page .eyebrow { font-family: 'Cinzel', serif; font-weight: 400; font-size: 9.5px; letter-spacing: 0.5em; color: var(--silver-dark); text-transform: uppercase; margin-bottom: 14px; text-align: center; width: 100%; }
  .page.dark .eyebrow,
  .page.deep-indigo .eyebrow { color: var(--silver); }
  .page h2 { font-family: 'Great Vibes', cursive; font-size: 48px; margin: 0 auto 14px; line-height: 1; font-weight: 400; color: var(--indigo-deep); text-align: center; width: 100%; }
  .page.dark h2,
  .page.deep-indigo h2 { color: var(--cream); }
  .page h3 { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10.5px; letter-spacing: 0.3em; color: var(--silver-dark); text-transform: uppercase; margin: 12px 0 8px; text-align: center; width: 100%; }
  .page.dark h3,
  .page.deep-indigo h3 { color: var(--silver); }

  /* TEXTO DE INFO */
  .page p { font-family: var(--font-info); font-weight: 400; font-size: 14px; line-height: 1.55; margin: 0 auto 10px; color: var(--indigo-deep); text-align: center; max-width: 380px; letter-spacing: 0.01em; }
  .page.dark p,
  .page.deep-indigo p { color: var(--cream); }
  .page p.lead { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; color: var(--indigo-soft); font-size: 14.5px; }
  .page.dark p.lead,
  .page.deep-indigo p.lead { color: rgba(237,238,246,0.85); }
  .page strong { color: var(--indigo-deep); font-weight: 600; }
  .page.dark strong,
  .page.deep-indigo strong { color: var(--cream); }
  .page em { font-style: italic; }

  .page .center-content { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; width: 100%; text-align: center; }
  .page .symbol-row { color: var(--silver); letter-spacing: 0.7em; font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; text-align: center; }

  .page .page-number { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); font-family: 'Cinzel', serif; font-weight: 400; font-size: 9px; letter-spacing: 0.35em; color: var(--silver-dark); }
  .page.dark .page-number,
  .page.deep-indigo .page-number { color: var(--silver); opacity: 0.55; }

  /* TAPA */
  .page.cover {
    background: radial-gradient(ellipse at 30% 30%, rgba(30,45,90,0.5), transparent 60%), radial-gradient(ellipse at 70% 70%, rgba(20,30,70,0.55), transparent 60%), linear-gradient(135deg, #0E1330 0%, #050812 50%, #181E45 100%);
    color: var(--cream); position: relative; box-shadow: inset 0 0 70px rgba(0,0,0,0.8);
  }
  .page.cover::before { content:''; position: absolute; inset: 22px; border: 1px solid rgba(212,220,236,0.45); }
  .page.cover::after { content:''; position: absolute; inset: 32px; border: 1px solid rgba(184,195,220,0.18); }
  .page.cover .page-inner { z-index: 2; align-items: center; justify-content: space-between; padding: 60px 30px; gap: 12px; text-align: center; }
  .page.cover .ornament-celtic-top { width: 80px; height: 80px; flex-shrink: 0; color: var(--silver); opacity: 0.95; }
  .page.cover .titulo-grande { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.5em; color: var(--silver); text-transform: uppercase; line-height: 1.4; text-align: center; }
  .page.cover h1 { font-family: 'Great Vibes', cursive; font-weight: 400; font-size: 58px; margin: 6px 0 8px; line-height: 1; color: var(--cream); text-shadow: 0 0 28px rgba(212,220,236,0.4); text-align: center; }
  .page.cover .marca-fina { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.6em; color: var(--silver-bright); text-transform: uppercase; text-align: center; }
  .page.cover .pie { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 11px; color: rgba(237,238,246,0.55); margin: 0; text-align: center; }

  svg.ornament { display: block; margin: 14px auto; color: var(--silver-dark); }
  svg.ornament.dark { color: var(--silver); }
  svg.ornament.tiny { width: 32px; height: 32px; }
  svg.ornament.small { width: 60px; height: 60px; }
  svg.ornament.med { width: 90px; height: 90px; }

  .indice { font-family: var(--font-info); font-size: 12px; letter-spacing: 0.05em; color: var(--indigo-deep); text-align: left; max-width: 380px; margin: 0 auto; }
  .indice-item { display: flex; justify-content: space-between; align-items: baseline; margin: 6px 0; }
  .indice-item .num { color: var(--silver-dark); margin-right: 8px; font-size: 11px; font-family: 'Cinzel', serif; letter-spacing: 0.15em; }
  .indice-item .name { flex: 1; }
  .indice-item .dots { flex: 1; border-bottom: 1px dotted var(--silver-dark); margin: 0 8px; align-self: end; height: 1px; }
  .indice-item .pg { color: var(--silver-dark); font-family: 'Cinzel', serif; }
  .indice-section { font-family: 'Cinzel', serif; font-weight: 500; font-size: 10px; letter-spacing: 0.35em; color: var(--silver-dark); text-transform: uppercase; margin: 12px 0 4px; padding-bottom: 4px; border-bottom: 1px solid var(--silver-dark); text-align: center; }

  .page .cita { font-family: 'Great Vibes', cursive; font-size: 40px; line-height: 1.2; color: var(--silver-dark); text-align: center; padding: 16px 14px; font-weight: 400; }
  .page.dark .cita,
  .page.deep-indigo .cita { color: var(--cream); font-size: 48px; }

  .foto-circle { width: 130px; height: 130px; border-radius: 50%; margin: 14px auto; overflow: hidden; border: 2px solid var(--silver); box-shadow: 0 8px 26px rgba(0,0,0,0.35); display: block; }
  .foto-circle img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .foto-rounded { width: 200px; height: 130px; border-radius: 16px; margin: 14px auto; overflow: hidden; border: 1px solid var(--silver); box-shadow: 0 6px 22px rgba(0,0,0,0.3); display: block; }
  .foto-rounded img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .foto-arch { width: 130px; height: 170px; border-radius: 65px 65px 6px 6px; margin: 14px auto; overflow: hidden; border: 1px solid var(--silver); box-shadow: 0 8px 26px rgba(0,0,0,0.35); display: block; }
  .foto-arch img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .foto-caption { font-family: 'Cinzel', serif; font-weight: 400; font-size: 9px; letter-spacing: 0.35em; color: var(--silver-dark); text-transform: uppercase; margin-top: 8px; text-align: center; }

  .consejo-card { background: var(--cream-light); border: 1px solid var(--silver); border-radius: 6px; padding: 12px 14px; margin: 8px auto; text-align: center; max-width: 360px; }
  .consejo-card .titulo { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.3em; color: var(--silver-dark); text-transform: uppercase; margin-bottom: 5px; text-align: center; }
  .consejo-card p { font-family: var(--font-info); font-size: 13.5px; margin: 0 auto; line-height: 1.5; max-width: none; text-align: center; }
  .consejo-card.warning { border-color: #6c7ca8; background: #e8edf7; }
  .consejo-card.warning .titulo { color: #3e4d75; }
  .consejo-card.elemento { background: linear-gradient(180deg, var(--cream-light) 0%, #DCE3F2 100%); border-width: 1.5px; }

  .elementos-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--silver-dark); margin: 10px auto; max-width: 380px; }
  .elemento-cell { padding: 12px 10px; border-right: 1px solid var(--silver-dark); border-bottom: 1px solid var(--silver-dark); text-align: center; }
  .elemento-cell:nth-child(2n) { border-right: none; }
  .elemento-cell:nth-last-child(-n+2) { border-bottom: none; }
  .elemento-cell .titulo { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.3em; color: var(--silver-dark); margin-bottom: 5px; text-align: center; }
  .elemento-cell .quien { font-family: var(--font-info); font-size: 12px; color: var(--indigo-deep); margin-bottom: 4px; font-weight: 500; text-align: center; }
  .elemento-cell .funcion { font-family: var(--font-info); font-size: 11.5px; color: var(--indigo-soft); line-height: 1.45; text-align: center; }

  .dia-item { padding: 6px 8px; border-bottom: 1px solid var(--line-silver); text-align: center; max-width: 360px; margin: 0 auto; }
  .dia-item:last-child { border-bottom: none; }
  .dia-item .num { font-family: 'Cinzel', serif; font-weight: 400; font-size: 9.5px; letter-spacing: 0.3em; color: var(--silver-dark); }
  .dia-item .titulo { font-family: 'Cinzel', serif; font-weight: 400; font-size: 9.5px; letter-spacing: 0.2em; color: var(--indigo-deep); }
  .dia-item .desc { font-family: var(--font-info); font-size: 12.5px; color: var(--indigo-soft); line-height: 1.5; margin-top: 2px; text-align: center; }

  .compendio-tabla { font-size: 11px; max-width: 380px; margin: 0 auto; }
  .compendio-row { display: flex; padding: 7px 0; border-bottom: 1px solid var(--line-silver); align-items: baseline; text-align: left; }
  .compendio-row:last-child { border-bottom: none; }
  .compendio-row .nombre { flex: 0 0 110px; color: var(--indigo-deep); letter-spacing: 0.18em; text-transform: uppercase; font-family: 'Cinzel', serif; font-weight: 400; font-size: 9.5px; }
  .compendio-row .uso { flex: 1; color: var(--indigo-soft); font-family: var(--font-info); font-size: 12.5px; }

  .faq { margin: 8px auto; padding-bottom: 8px; border-bottom: 1px dotted var(--line-silver); text-align: center; max-width: 380px; }
  .faq:last-child { border-bottom: none; }
  .faq .pregunta { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.2em; color: var(--silver-dark); text-transform: uppercase; margin-bottom: 5px; text-align: center; }
  .faq .respuesta { font-family: var(--font-info); font-size: 12.5px; color: var(--indigo-soft); line-height: 1.55; margin: 0 auto; text-align: center; }

  /* FICHA ELFO · card destacada */
  .ser-card { background: linear-gradient(160deg, var(--cream-light) 0%, #D5DCEE 100%); border: 1.5px solid var(--silver); border-radius: 8px; padding: 14px 16px; margin: 8px auto; max-width: 380px; box-shadow: 0 4px 14px rgba(0,0,0,0.12); }
  .ser-card .ser-nombre { font-family: 'Great Vibes', cursive; font-size: 32px; color: var(--indigo-deep); margin: 0 0 4px; line-height: 1; }
  .ser-card .ser-energia { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 0.4em; color: var(--silver-dark); text-transform: uppercase; margin-bottom: 8px; }
  .ser-card .ser-detalle { font-family: var(--font-info); font-size: 12.5px; color: var(--indigo-soft); line-height: 1.5; margin: 0 auto 8px; text-align: center; }
  .ser-card .ser-meta { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 8px; }
  .ser-card .ser-meta span { font-family: 'Cinzel', serif; font-size: 8.5px; letter-spacing: 0.2em; color: var(--silver-dark); text-transform: uppercase; padding: 3px 8px; border: 1px solid var(--silver-dark); border-radius: 100px; }

  .neuro-tag { display: inline-block; margin-top: 6px; padding: 4px 10px; background: var(--indigo-deep); color: var(--silver); font-family: 'Cinzel', serif; font-size: 8.5px; letter-spacing: 0.3em; text-transform: uppercase; border-radius: 4px; }

  .cta-final { display: flex; flex-direction: column; gap: 10px; margin: 12px auto; max-width: 380px; }
  .cta-final-btn { display: block; padding: 14px 16px; background: var(--cream-light); border: 1px solid var(--silver); border-radius: 4px; text-decoration: none; color: var(--indigo-deep); transition: all 0.3s; text-align: center; }
  .cta-final-btn:hover { background: var(--silver); color: var(--black-deep); }
  .cta-final-btn .cta-titulo { font-family: 'Cinzel', serif; font-weight: 500; font-size: 10px; letter-spacing: 0.3em; color: var(--silver-dark); text-transform: uppercase; margin-bottom: 4px; text-align: center; }
  .cta-final-btn:hover .cta-titulo { color: var(--black-deep); }
  .cta-final-btn .cta-text { font-family: var(--font-info); font-size: 13px; text-align: center; }

  .libro-controls { margin: 28px auto 0; display: flex; justify-content: center; align-items: center; gap: 18px; flex-wrap: wrap; }
  .libro-controls button { background: rgba(0,0,0,0.6); color: var(--silver); border: 1px solid var(--silver); padding: 12px 26px; font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.35em; text-transform: uppercase; cursor: pointer; transition: all 0.3s; backdrop-filter: blur(4px); }
  .libro-controls button:hover { background: var(--silver); color: var(--black-deep); }
  .libro-controls button:disabled { opacity: 0.4; cursor: not-allowed; }
  .libro-controls .page-indicator { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.35em; color: var(--silver); text-shadow: 0 2px 8px rgba(0,0,0,0.7); }
  .sound-toggle { background: rgba(0,0,0,0.6); color: var(--silver); border: 1px solid var(--silver); padding: 8px 14px; font-family: 'Cinzel', serif; font-weight: 400; font-size: 9px; letter-spacing: 0.3em; cursor: pointer; border-radius: 100px; }
