{% doc %}
  Renders the locked state for gated lineage flipbooks.

  @param {string} title - The flipbook title.
  @param {string} required_label - The lineage purchase required to open it.

  @example
  {% render 'duendes-flipbook-locked', title: 'La Guia de las Hadas', required_label: 'una Hada' %}
{% enddoc %}

<style>
  .duendes-flipbook-locked {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 64px 20px;
    background:
      radial-gradient(circle at 50% 10%, rgba(201, 169, 97, 0.16), transparent 42%),
      linear-gradient(180deg, #130f0a 0%, #050403 100%);
    color: #f5f0e1;
    text-align: center;
  }

  .duendes-flipbook-locked__card {
    max-width: 560px;
    border: 1px solid rgba(201, 169, 97, 0.42);
    background: rgba(8, 6, 4, 0.82);
    padding: clamp(32px, 6vw, 56px);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
  }

  .duendes-flipbook-locked__glyph {
    color: #c9a961;
    letter-spacing: 0.45em;
    margin: 0 0 18px;
  }

  .duendes-flipbook-locked__eyebrow {
    margin: 0 0 14px;
    font-family: Cinzel, serif;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #c9a961;
  }

  .duendes-flipbook-locked__title {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(34px, 7vw, 56px);
    font-weight: 500;
    line-height: 1.05;
  }

  .duendes-flipbook-locked__copy {
    margin: 22px auto 0;
    max-width: 430px;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 18px;
    line-height: 1.55;
    color: rgba(245, 240, 225, 0.82);
  }

  .duendes-flipbook-locked__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 30px;
  }

  .duendes-flipbook-locked__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 22px;
    border: 1px solid #c9a961;
    color: #130f0a;
    background: #c9a961;
    font-family: Cinzel, serif;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .duendes-flipbook-locked__button--secondary {
    color: #f5f0e1;
    background: transparent;
  }
</style>

<section class="duendes-flipbook-locked" aria-labelledby="duendes-flipbook-locked-title">
  <div class="duendes-flipbook-locked__card">
    <p class="duendes-flipbook-locked__glyph" aria-hidden="true">✦ ✦ ✦</p>
    <p class="duendes-flipbook-locked__eyebrow">Libro sellado</p>
    <h1 class="duendes-flipbook-locked__title" id="duendes-flipbook-locked-title">{{ title | escape }}</h1>
    <p class="duendes-flipbook-locked__copy">
      Este libro se abre solo para clientes que adoptaron {{ required_label | escape }}.
      Si ya lo hiciste, inicia sesion con la cuenta usada en la compra.
    </p>
    <div class="duendes-flipbook-locked__actions">
      <a class="duendes-flipbook-locked__button" href="{{ routes.account_login_url }}">Iniciar sesion</a>
      <a class="duendes-flipbook-locked__button duendes-flipbook-locked__button--secondary" href="/pages/el-portal">Volver al portal</a>
    </div>
  </div>
</section>
