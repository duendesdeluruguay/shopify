{% comment %}
  La Guía de los Seres Deluxe · Duendes del Uruguay · v4.0 BIBLIA
  · Tipografía: Cinzel (títulos) + Great Vibes (display) + Cormorant Garamond (body)
  · Paleta púrpura profundo + cobre brillante · ULTRA mágica
  · ~46 páginas · seres premium con cristales engarzados, vibración altísima
  · Brand voice Río de la Plata, "vos", refinado, premium, sin ostentación
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Saira+Condensed:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  .libro-wrap {
    --black-deep: #0a0710; --cream: #F5EAF7; --cream-light: #FAF4FB;
    --purple-deep: #2a0f4a; --purple-mid: #4a1f7a; --purple-soft: #6b3aa0;
    --purple-blush: #efe5f4; --purple-pastel: #e0d0ec;
    --copper: #c87842; --copper-bright: #e0a07a; --copper-dark: #8a4d22;
    --rose-antique: #a86b7a;
    --gold: #C9A961; --gold-bright: #D8B872; --gold-dark: #8b7137;
    --line-copper: rgba(200,120,66,0.28);
    --font-info: 'Cormorant Garamond', Georgia, serif;

    color: var(--cream); font-family: 'Cormorant Garamond', Georgia, serif;
    min-height: 100vh; padding: 28px 16px 60px; text-align: center;
    background-color: #0a0710;
    background-image:
      radial-gradient(ellipse at 50% 30%, rgba(74,31,122,0.55) 0%, rgba(10,7,16,0.94) 70%),
      radial-gradient(circle at 12% 88%, rgba(200,120,66,0.16) 0%, transparent 40%),
      radial-gradient(circle at 88% 12%, rgba(107,58,160,0.20) 0%, transparent 45%),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='600' height='600' viewBox='0 0 600 600'><g fill='none' stroke='%23c87842' stroke-width='1.5' opacity='0.08'><text x='300' y='180' text-anchor='middle' font-family='serif' font-style='italic' font-size='44' fill='%23c87842' opacity='0.9'>Seres Deluxe</text><text x='300' y='220' text-anchor='middle' font-family='serif' font-size='14' letter-spacing='8' fill='%23c87842' opacity='0.85'>%E2%9C%A6  %E2%9C%A6  %E2%9C%A6</text><text x='300' y='460' text-anchor='middle' font-family='serif' font-style='italic' font-size='44' fill='%23c87842' opacity='0.9'>Edición Ultra Mágica</text><text x='300' y='500' text-anchor='middle' font-family='serif' font-size='14' letter-spacing='8' fill='%23c87842' opacity='0.85'>%E2%9C%A6  %E2%9C%A6  %E2%9C%A6</text></g></svg>"),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='400' viewBox='0 0 400 400'><defs><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3'/><feColorMatrix values='0 0 0 0 0.55 0 0 0 0 0.35 0 0 0 0 0.68 0 0 0 0.05 0'/></filter></defs><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    background-size: cover, cover, cover, 600px 600px, 400px 400px;
    background-repeat: no-repeat, no-repeat, no-repeat, repeat, repeat;
    background-attachment: fixed; position: relative; min-height: 100vh; overflow-x: hidden;
  }

  /* GLOW púrpura+cobre en esquinas */
  .libro-wrap::before {
    content:''; position: fixed; top: -100px; right: -100px; width: 500px; height: 500px; pointer-events: none; z-index: 0;
    background: radial-gradient(circle at center, rgba(200,120,66,0.22) 0%, rgba(200,120,66,0.06) 40%, transparent 70%);
    animation: glowPulse 9s ease-in-out infinite;
  }
  @keyframes glowPulse {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
  }
  .libro-wrap::after {
    content:''; position: fixed; bottom: -80px; left: -80px; width: 400px; height: 400px; pointer-events: none; z-index: 0;
    background: radial-gradient(circle at center, rgba(107,58,160,0.20) 0%, rgba(107,58,160,0.06) 50%, transparent 75%);
    animation: glowPulse 11s ease-in-out infinite reverse;
  }

  .libro-wrap > * { position: relative; z-index: 1; }
  .libro-wrap * { box-sizing: border-box; }

  .libro-header { max-width: 760px; margin: 0 auto 24px; text-align: center; }
  .libro-header .eyebrow { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.5em; color: var(--copper-bright); text-transform: uppercase; margin-bottom: 12px; text-shadow: 0 2px 8px rgba(0,0,0,0.7); }
  .libro-header h1 { font-family: 'Great Vibes', cursive; font-size: clamp(44px, 6.5vw, 72px); margin: 0 0 8px; line-height: 1; font-weight: 400; color: var(--cream); text-shadow: 0 4px 18px rgba(74,31,122,0.85); }
  .libro-header .sub { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.5em; color: var(--copper-bright); text-transform: uppercase; text-shadow: 0 2px 8px rgba(0,0,0,0.7); }

  .lang-overlay { position: fixed; inset: 0; background: rgba(10,7,16,0.97); z-index: 9999; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8px); }
  .lang-overlay.hide { display: none; }
  .lang-box { max-width: 480px; text-align: center; padding: 40px 32px; border: 1px solid var(--copper); background: linear-gradient(160deg, #1a0c30 0%, #0a0710 100%); position: relative; }
  .lang-box::before { content:''; position: absolute; inset: 8px; border: 1px solid rgba(200,120,66,0.32); pointer-events:none; }
  .lang-box .ornament { color: var(--copper-bright); font-family: 'Cinzel', serif; font-size: 14px; letter-spacing: 0.7em; margin-bottom: 18px; }
  .lang-box h2 { font-family: 'Great Vibes', cursive; font-weight: 400; font-size: 56px; color: var(--cream); margin: 0 0 8px; line-height: 1; }
  .lang-box .pretitle { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.4em; color: var(--copper-bright); text-transform: uppercase; margin-bottom: 18px; }
  .lang-box p { font-family: var(--font-info); font-size: 16px; color: rgba(245,234,247,0.85); margin: 14px 0 28px; }
  .lang-buttons { display: flex; gap: 14px; justify-content: center; }
  .lang-buttons button { background: transparent; color: var(--cream); border: 1px solid var(--copper); padding: 14px 32px; font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.4em; text-transform: uppercase; cursor: pointer; transition: all 0.3s; }
  .lang-buttons button:hover { background: var(--copper); color: var(--black-deep); }
  .lang-buttons .recommended { background: var(--copper); color: var(--black-deep); }

  .flipbook-container { display: flex; justify-content: center; align-items: center; margin: 0 auto; max-width: 1120px; min-height: 600px; padding: 16px; }
  #book {
    box-shadow: 0 32px 100px rgba(0,0,0,0.85), 0 0 0 8px rgba(30,15,55,0.7), 0 0 0 9px var(--copper-dark);
    border-radius: 4px;
    touch-action: pan-y;
  }
  .page { background: var(--cream); color: var(--purple-deep); overflow: hidden; }
  .page.purple { background: linear-gradient(160deg, #f4ebf8 0%, #e6d4f0 100%); color: var(--purple-deep); }
  .page.deep-purple { background: linear-gradient(160deg, #1a0c30 0%, #0a0710 100%); color: var(--cream); }
  .page-inner { padding: 32px 30px 28px; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; text-align: center; gap: 6px; }
  .page.dark, .page.deep-purple { background: var(--black-deep); color: var(--cream); }
  .page.deep-purple { background: linear-gradient(160deg, #1a0c30 0%, #0a0710 100%); }
  .page.dark .page-inner::before, .page.deep-purple .page-inner::before { content: ''; position: absolute; inset: 14px; border: 1px solid rgba(200,120,66,0.28); pointer-events: none; }

  .page .eyebrow { font-family: 'Cinzel', serif; font-weight: 400; font-size: 9.5px; letter-spacing: 0.5em; color: var(--copper-dark); text-transform: uppercase; margin-bottom: 14px; text-align: center; width: 100%; }
  .page.dark .eyebrow, .page.deep-purple .eyebrow { color: var(--copper-bright); }
  .page.purple .eyebrow { color: var(--copper-dark); }
  .page h2 { font-family: 'Great Vibes', cursive; font-size: 48px; margin: 0 auto 14px; line-height: 1; font-weight: 400; color: var(--purple-deep); text-align: center; width: 100%; }
  .page.dark h2, .page.deep-purple h2 { color: var(--cream); }
  .page h3 { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10.5px; letter-spacing: 0.3em; color: var(--copper-dark); text-transform: uppercase; margin: 12px 0 8px; text-align: center; width: 100%; }
  .page.dark h3, .page.deep-purple h3 { color: var(--copper-bright); }

  .page p { font-family: var(--font-info); font-weight: 400; font-size: 14px; line-height: 1.55; margin: 0 auto 10px; color: var(--purple-deep); text-align: center; max-width: 380px; letter-spacing: 0.01em; }
  .page.dark p, .page.deep-purple p { color: var(--cream); }
  .page p.lead { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; color: var(--purple-mid); font-size: 14.5px; }
  .page.dark p.lead, .page.deep-purple p.lead { color: rgba(245,234,247,0.85); }
  .page strong { color: var(--purple-deep); font-weight: 600; }
  .page.dark strong, .page.deep-purple strong { color: var(--cream); }
  .page em { font-style: italic; }

  .page .center-content { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; width: 100%; text-align: center; }
  .page .symbol-row { color: var(--copper-bright); letter-spacing: 0.7em; font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; text-align: center; }

  .page .page-number { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); font-family: 'Cinzel', serif; font-weight: 400; font-size: 9px; letter-spacing: 0.35em; color: var(--copper-dark); }
  .page.dark .page-number, .page.deep-purple .page-number { color: var(--copper-bright); opacity: 0.6; }

  /* TAPA */
  .page.cover {
    background: radial-gradient(ellipse at 30% 30%, rgba(74,31,122,0.5), transparent 60%), radial-gradient(ellipse at 70% 70%, rgba(40,18,72,0.5), transparent 60%), linear-gradient(135deg, #1a0c30 0%, #0a0710 50%, #2a0f4a 100%);
    color: var(--cream); position: relative; box-shadow: inset 0 0 70px rgba(0,0,0,0.8);
  }
  .page.cover::before { content:''; position: absolute; inset: 22px; border: 1px solid rgba(200,120,66,0.55); }
  .page.cover::after { content:''; position: absolute; inset: 32px; border: 1px solid rgba(200,120,66,0.22); }
  .page.cover .page-inner { z-index: 2; align-items: center; justify-content: space-between; padding: 60px 30px; gap: 12px; text-align: center; }
  .page.cover .ornament-celtic-top { width: 80px; height: 80px; flex-shrink: 0; color: var(--copper-bright); opacity: 0.95; }
  .page.cover .titulo-grande { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.5em; color: var(--copper-bright); text-transform: uppercase; line-height: 1.4; text-align: center; }
  .page.cover h1 { font-family: 'Great Vibes', cursive; font-weight: 400; font-size: 58px; margin: 6px 0 8px; line-height: 1; color: var(--cream); text-shadow: 0 0 28px rgba(200,120,66,0.45); text-align: center; }
  .page.cover .marca-fina { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.6em; color: var(--copper-bright); text-transform: uppercase; text-align: center; }
  .page.cover .pie { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 11px; color: rgba(245,234,247,0.6); margin: 0; text-align: center; }

  svg.ornament { display: block; margin: 14px auto; color: var(--copper-dark); }
  svg.ornament.dark { color: var(--copper-bright); }
  svg.ornament.tiny { width: 32px; height: 32px; }
  svg.ornament.small { width: 60px; height: 60px; }
  svg.ornament.med { width: 90px; height: 90px; }

  .indice { font-family: var(--font-info); font-size: 12px; letter-spacing: 0.05em; color: var(--purple-deep); text-align: left; max-width: 380px; margin: 0 auto; }
  .indice-item { display: flex; justify-content: space-between; align-items: baseline; margin: 6px 0; }
  .indice-item .num { color: var(--copper-dark); margin-right: 8px; font-size: 11px; font-family: 'Cinzel', serif; letter-spacing: 0.15em; }
  .indice-item .name { flex: 1; }
  .indice-item .dots { flex: 1; border-bottom: 1px dotted var(--copper-dark); margin: 0 8px; align-self: end; height: 1px; }
  .indice-item .pg { color: var(--copper-dark); font-family: 'Cinzel', serif; }
  .indice-section { font-family: 'Cinzel', serif; font-weight: 500; font-size: 10px; letter-spacing: 0.35em; color: var(--copper-bright); text-transform: uppercase; margin: 12px 0 4px; padding-bottom: 4px; border-bottom: 1px solid var(--copper-dark); text-align: center; }

  .page .cita { font-family: 'Great Vibes', cursive; font-size: 40px; line-height: 1.2; color: var(--copper-dark); text-align: center; padding: 16px 14px; font-weight: 400; }
  .page.dark .cita, .page.deep-purple .cita { color: var(--cream); font-size: 48px; }

  .foto-circle { width: 130px; height: 130px; border-radius: 50%; margin: 14px auto; overflow: hidden; border: 2px solid var(--copper); box-shadow: 0 8px 26px rgba(0,0,0,0.4); display: block; }
  .foto-circle img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .foto-rounded { width: 200px; height: 130px; border-radius: 16px; margin: 14px auto; overflow: hidden; border: 1px solid var(--copper); box-shadow: 0 6px 22px rgba(0,0,0,0.35); display: block; }
  .foto-rounded img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .foto-arch { width: 130px; height: 170px; border-radius: 65px 65px 6px 6px; margin: 14px auto; overflow: hidden; border: 1px solid var(--copper); box-shadow: 0 8px 26px rgba(0,0,0,0.4); display: block; }
  .foto-arch img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .foto-caption { font-family: 'Cinzel', serif; font-weight: 400; font-size: 9px; letter-spacing: 0.35em; color: var(--copper-dark); text-transform: uppercase; margin-top: 8px; text-align: center; }

  .consejo-card { background: var(--cream-light); border: 1px solid var(--copper); border-radius: 6px; padding: 12px 14px; margin: 8px auto; text-align: center; max-width: 360px; }
  .consejo-card .titulo { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.3em; color: var(--copper-dark); text-transform: uppercase; margin-bottom: 5px; text-align: center; }
  .consejo-card p { font-family: var(--font-info); font-size: 13.5px; margin: 0 auto; line-height: 1.5; max-width: none; text-align: center; }
  .consejo-card.warning { border-color: #c47844; background: #fce3d3; }
  .consejo-card.warning .titulo { color: #a85e2c; }
  .consejo-card.elemento { background: linear-gradient(180deg, var(--cream-light) 0%, var(--purple-blush) 100%); border-width: 1.5px; }

  .elementos-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--copper-dark); margin: 10px auto; max-width: 380px; }
  .elemento-cell { padding: 12px 10px; border-right: 1px solid var(--copper-dark); border-bottom: 1px solid var(--copper-dark); text-align: center; }
  .elemento-cell:nth-child(2n) { border-right: none; }
  .elemento-cell:nth-last-child(-n+2) { border-bottom: none; }
  .elemento-cell .titulo { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.3em; color: var(--copper-dark); margin-bottom: 5px; text-align: center; }
  .elemento-cell .quien { font-family: var(--font-info); font-size: 12px; color: var(--purple-deep); margin-bottom: 4px; font-weight: 500; text-align: center; }
  .elemento-cell .funcion { font-family: var(--font-info); font-size: 11.5px; color: var(--purple-mid); line-height: 1.45; text-align: center; }

  .dia-item { padding: 6px 8px; border-bottom: 1px solid var(--line-copper); text-align: center; max-width: 360px; margin: 0 auto; }
  .dia-item:last-child { border-bottom: none; }
  .dia-item .num { font-family: 'Cinzel', serif; font-weight: 400; font-size: 9.5px; letter-spacing: 0.3em; color: var(--copper-dark); }
  .dia-item .titulo { font-family: 'Cinzel', serif; font-weight: 400; font-size: 9.5px; letter-spacing: 0.2em; color: var(--purple-deep); }
  .dia-item .desc { font-family: var(--font-info); font-size: 12.5px; color: var(--purple-mid); line-height: 1.5; margin-top: 2px; text-align: center; }

  .compendio-tabla { font-size: 11px; max-width: 380px; margin: 0 auto; }
  .compendio-row { display: flex; padding: 7px 0; border-bottom: 1px solid var(--line-copper); align-items: baseline; text-align: left; }
  .compendio-row:last-child { border-bottom: none; }
  .compendio-row .nombre { flex: 0 0 110px; color: var(--purple-deep); letter-spacing: 0.18em; text-transform: uppercase; font-family: 'Cinzel', serif; font-weight: 400; font-size: 9.5px; }
  .compendio-row .uso { flex: 1; color: var(--purple-mid); font-family: var(--font-info); font-size: 12.5px; }

  .faq { margin: 8px auto; padding-bottom: 8px; border-bottom: 1px dotted var(--line-copper); text-align: center; max-width: 380px; }
  .faq:last-child { border-bottom: none; }
  .faq .pregunta { font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.2em; color: var(--copper-dark); text-transform: uppercase; margin-bottom: 5px; text-align: center; }
  .faq .respuesta { font-family: var(--font-info); font-size: 12.5px; color: var(--purple-mid); line-height: 1.55; margin: 0 auto; text-align: center; }

  /* SER CARD · ULTRA MÁGICA púrpura+cobre */
  .ser-card { background: linear-gradient(160deg, #f4ebf8 0%, #e0c8ec 100%); border: 1.5px solid var(--copper); border-radius: 8px; padding: 14px 16px; margin: 8px auto; max-width: 380px; box-shadow: 0 4px 14px rgba(74,31,122,0.18), inset 0 0 0 1px rgba(200,120,66,0.25); }
  .ser-card .ser-nombre { font-family: 'Great Vibes', cursive; font-size: 32px; color: var(--purple-deep); margin: 0 0 4px; line-height: 1; }
  .ser-card .ser-energia { font-family: 'Cinzel', serif; font-size: 9px; letter-spacing: 0.4em; color: var(--copper-dark); text-transform: uppercase; margin-bottom: 8px; }
  .ser-card .ser-detalle { font-family: var(--font-info); font-size: 12.5px; color: var(--purple-mid); line-height: 1.5; margin: 0 auto 8px; text-align: center; }
  .ser-card .ser-meta { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 8px; }
  .ser-card .ser-meta span { font-family: 'Cinzel', serif; font-size: 8.5px; letter-spacing: 0.2em; color: var(--copper-dark); text-transform: uppercase; padding: 3px 8px; border: 1px solid var(--copper-dark); border-radius: 100px; }

  .neuro-tag { display: inline-block; margin-top: 6px; padding: 4px 10px; background: var(--purple-deep); color: var(--copper-bright); font-family: 'Cinzel', serif; font-size: 8.5px; letter-spacing: 0.3em; text-transform: uppercase; border-radius: 4px; }

  .cta-final { display: flex; flex-direction: column; gap: 10px; margin: 12px auto; max-width: 380px; }
  .cta-final-btn { display: block; padding: 14px 16px; background: var(--cream-light); border: 1px solid var(--copper); border-radius: 4px; text-decoration: none; color: var(--purple-deep); transition: all 0.3s; text-align: center; }
  .cta-final-btn:hover { background: var(--copper); color: var(--cream); }
  .cta-final-btn .cta-titulo { font-family: 'Cinzel', serif; font-weight: 500; font-size: 10px; letter-spacing: 0.3em; color: var(--copper-dark); text-transform: uppercase; margin-bottom: 4px; text-align: center; }
  .cta-final-btn:hover .cta-titulo { color: var(--cream); }
  .cta-final-btn .cta-text { font-family: var(--font-info); font-size: 13px; text-align: center; }

  .libro-controls { margin: 28px auto 0; display: flex; justify-content: center; align-items: center; gap: 18px; flex-wrap: wrap; }
  .libro-controls button { background: rgba(10,7,16,0.7); color: var(--copper-bright); border: 1px solid var(--copper); padding: 12px 26px; font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.35em; text-transform: uppercase; cursor: pointer; transition: all 0.3s; backdrop-filter: blur(4px); }
  .libro-controls button:hover { background: var(--copper); color: var(--black-deep); }
  .libro-controls button:disabled { opacity: 0.4; cursor: not-allowed; }
  .libro-controls .page-indicator { font-family: 'Cinzel', serif; font-weight: 400; font-size: 11px; letter-spacing: 0.35em; color: var(--copper-bright); text-shadow: 0 2px 8px rgba(0,0,0,0.7); }
  .sound-toggle { background: rgba(10,7,16,0.7); color: var(--copper-bright); border: 1px solid var(--copper); padding: 8px 14px; font-family: 'Cinzel', serif; font-weight: 400; font-size: 9px; letter-spacing: 0.3em; cursor: pointer; border-radius: 100px; }
  .sound-toggle.muted { opacity: 0.4; }

  .libro-footer { margin-top: 36px; text-align: center; font-family: 'Cinzel', serif; font-weight: 400; font-size: 10px; letter-spacing: 0.4em; color: rgba(200,120,66,0.75); text-transform: uppercase; text-shadow: 0 2px 8px rgba(0,0,0,0.7); }
  .libro-footer a { color: var(--copper-bright); text-decoration: none; margin: 0 12px; }

  /* AURORAS · luces púrpura + cobre */
  .auroras { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; mix-blend-mode: screen; }
  .auroras .luz {
    position: absolute; width: 720px; height: 720px; border-radius: 50%;
    filter: blur(140px); opacity: 0; will-change: opacity, transform;
    animation: auroraRespirar 22s ease-in-out infinite;
  }
  .luz-violeta-deep {
    background: radial-gradient(circle at 50% 50%, rgba(160,80,220,0.70) 0%, rgba(160,80,220,0.30) 35%, transparent 70%);
    top: -160px; left: -120px; animation-delay: 0s;
  }
  .luz-cobre {
    background: radial-gradient(circle at 50% 50%, rgba(224,160,122,0.65) 0%, rgba(200,120,66,0.25) 35%, transparent 70%);
    top: 8%; right: -180px; animation-delay: 5s; width: 680px; height: 680px;
  }
  .luz-magenta {
    background: radial-gradient(circle at 50% 50%, rgba(220,90,180,0.55) 0%, rgba(220,90,180,0.22) 35%, transparent 70%);
    bottom: -180px; right: 18%; animation-delay: 9s;
  }
  .luz-purpura-clara {
    background: radial-gradient(circle at 50% 50%, rgba(176,143,203,0.55) 0%, rgba(176,143,203,0.22) 35%, transparent 70%);
    bottom: 5%; left: -160px; animation-delay: 13s; width: 760px; height: 760px;
  }
  .luz-rosa {
    background: radial-gradient(circle at 50% 50%, rgba(212,168,179,0.55) 0%, rgba(212,168,179,0.22) 35%, transparent 70%);
    top: 45%; left: 30%; animation-delay: 7s; width: 600px; height: 600px;
  }
  .luz-cobre-claro {
    background: radial-gradient(circle at 50% 50%, rgba(224,160,122,0.50) 0%, rgba(200,120,66,0.20) 35%, transparent 70%);
    top: 60%; right: 8%; animation-delay: 16s; width: 640px; height: 640px;
  }
  @keyframes auroraRespirar {
    0%   { opacity: 0;    transform: scale(0.85) translate(0, 0); }
    18%  { opacity: 0.55; transform: scale(1)    translate(40px, -30px); }
    50%  { opacity: 0.7;  transform: scale(1.12) translate(-50px, 60px); }
    82%  { opacity: 0.4;  transform: scale(1.18) translate(30px, -20px); }
    100% { opacity: 0;    transform: scale(1.25) translate(0, 0); }
  }

  /* Partículas cobre flotando */
  .particulas { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
  .particulas span {
    position: absolute; width: 5px; height: 5px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,200,140,0.95), rgba(200,120,66,0.4) 60%, transparent 100%);
    box-shadow: 0 0 8px rgba(224,160,122,0.85);
    animation: flotar 12s linear infinite;
    bottom: -20px;
  }
  .particulas span:nth-child(1) { left: 8%; animation-delay: 0s; animation-duration: 14s; }
  .particulas span:nth-child(2) { left: 18%; animation-delay: 1s; animation-duration: 11s; width: 4px; height: 4px; }
  .particulas span:nth-child(3) { left: 28%; animation-delay: 4s; animation-duration: 13s; width: 6px; height: 6px; }
  .particulas span:nth-child(4) { left: 38%; animation-delay: 2s; animation-duration: 12s; }
  .particulas span:nth-child(5) { left: 48%; animation-delay: 6s; animation-duration: 15s; width: 3px; height: 3px; }
  .particulas span:nth-child(6) { left: 58%; animation-delay: 3s; animation-duration: 10s; }
  .particulas span:nth-child(7) { left: 68%; animation-delay: 5s; animation-duration: 13s; width: 5px; height: 5px; }
  .particulas span:nth-child(8) { left: 78%; animation-delay: 7s; animation-duration: 14s; }
  .particulas span:nth-child(9) { left: 88%; animation-delay: 0.5s; animation-duration: 12s; width: 4px; height: 4px; }
  .particulas span:nth-child(10) { left: 92%; animation-delay: 8s; animation-duration: 16s; }
  .particulas span:nth-child(11) { left: 12%; animation-delay: 9s; animation-duration: 11s; width: 3px; height: 3px; }
  .particulas span:nth-child(12) { left: 32%; animation-delay: 10s; animation-duration: 13s; }
  .particulas span:nth-child(13) { left: 52%; animation-delay: 11s; animation-duration: 12s; width: 5px; height: 5px; }
  .particulas span:nth-child(14) { left: 72%; animation-delay: 4.5s; animation-duration: 14s; }
  .particulas span:nth-child(15) { left: 84%; animation-delay: 7.5s; animation-duration: 13s; width: 4px; height: 4px; }

  @keyframes flotar {
    0% { transform: translateY(0) translateX(0); opacity: 0; }
    8% { opacity: 1; }
    92% { opacity: 1; }
    100% { transform: translateY(-110vh) translateX(40px); opacity: 0; }
  }

